# Copy file ini ke .env.local untuk development
# Copy file ini ke .env.production untuk production
# Lalu isi dengan credentials yang sesuai

# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="change-this-secret-min-10-chars"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 (object storage untuk dokumentasi)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gbi-dokumentasi
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
